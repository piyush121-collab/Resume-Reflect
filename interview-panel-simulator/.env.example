# Copy this file to .env and fill in your OpenRouter API key.
# Get a free key at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Explicit model configuration for free tier models (never use openrouter/free router)
# Verify current free models at https://openrouter.ai/models?max_price=0
MODEL_PROFILE_BUILDER=inclusionai/ling-3.0-flash-fin:free
MODEL_TECHNICAL=inclusionai/ling-3.0-flash-fin:free
MODEL_HR_CULTURE=inclusionai/ling-3.0-flash-fin:free
MODEL_HIRING_MANAGER=inclusionai/ling-3.0-flash-fin:free
MODEL_SKEPTIC=inclusionai/ling-3.0-flash-fin:free
MODEL_CHAIR=inclusionai/ling-3.0-flash-fin:free
MODEL_COMPARATOR=inclusionai/ling-3.0-flash-fin:free

# LLM Reliability & Fallback Engine configuration
LLM_MAX_RETRIES=2
LLM_TIMEOUT_MS=60000
LLM_FALLBACK_MODELS=inclusionai/ling-3.0-flash-fin:free

# Enable detailed verbose logging (optional)
# DEBUG_LLM=true
